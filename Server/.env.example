PORT=5000
NODE_ENV=development  # change  production when deployed

# Development (Local Docker PostgreSQL)
DEV_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Production (e.g. Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Jwt Tokens
JWT_SECRET=your_long_random_secret_key_here
JWT_EXPIRES_IN=1d


Front_End_url = "http://localhost:5173"